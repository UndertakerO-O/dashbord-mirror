generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    Int               @id @default(autoincrement())
  email                 String            @unique @db.VarChar(255)
  passwordHash          String            @db.VarChar(255)
  isConfirmed           Boolean           @default(false)
  confirmationTokenHash String?           @unique @db.VarChar(128)
  confirmationExpiresAt DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  sessions              Session[]
  oauthStates            OAuthState[]
  oauthConnections       OAuthConnection[]
  subscriptions         Subscription[]
  dashboardWidgets      DashboardWidget[]
}

model Session {
  id        String   @id @default(cuid())
  userId    Int
  tokenHash String   @unique @db.VarChar(128)
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model OAuthState {
  id        String   @id @default(cuid())
  userId    Int?
  stateHash String   @unique @db.VarChar(128)
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model OAuthConnection {
  id                String   @id @default(cuid())
  userId            Int
  provider          String   @db.VarChar(50)
  providerAccountId String   @db.VarChar(255)
  accessTokenCipher String   @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
  @@index([userId])
}

model Service {
  id            Int            @id @default(autoincrement())
  name          String         @unique @db.VarChar(100)
  description   String         @db.VarChar(500)
  createdAt     DateTime       @default(now())
  widgets       Widget[]
  subscriptions Subscription[]
}

model Widget {
  id               Int               @id @default(autoincrement())
  serviceId        Int
  name             String            @db.VarChar(100)
  description      String            @db.VarChar(500)
  service          Service           @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  parameters       WidgetParameter[]
  dashboardWidgets DashboardWidget[]
  createdAt        DateTime          @default(now())

  @@unique([serviceId, name])
}

model WidgetParameter {
  id       Int    @id @default(autoincrement())
  widgetId Int
  name     String @db.VarChar(100)
  type     String @db.VarChar(20)
  widget   Widget @relation(fields: [widgetId], references: [id], onDelete: Cascade)

  @@unique([widgetId, name])
}

model Subscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  serviceId Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([userId, serviceId])
}

model DashboardWidget {
  id            Int      @id @default(autoincrement())
  userId        Int
  widgetId      Int
  configuration Json
  refreshRate   Int      @default(60)
  positionX     Int      @default(0)
  positionY     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  widget        Widget   @relation(fields: [widgetId], references: [id], onDelete: Cascade)
}
